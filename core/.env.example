APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# --- Central integration (core/app/Central/Config/CentralConfig.php) ---
# Placeholders only. Every variable is required by the code path that reads it; a missing
# value fails that path with an error that names the variable.
#
# Name mapping with the Scheduled Node module (scheduled/.env.example, SCHEDULED_* names):
#   CENTRAL_ORIGIN                   is the same value as SCHEDULED_CENTRAL_ORIGIN
#   product id ('scheduled', fixed in CentralConfig::SCHEDULED_PRODUCT_ID) is SCHEDULED_PRODUCT_ID
# Different values, never copy between them:
#   CENTRAL_OIDC_AUDIENCE is the sign-in audience set by the operator
#   SCHEDULED_CENTRAL_AUDIENCE is the link-assertion aud claim (contract value titan-central)
# CENTRAL_EVENTS_HMAC_SECRET and CENTRAL_SERVICE_* have no Node counterpart.

# Central origin, for example https://central.example (no path, query or fragment).
CENTRAL_ORIGIN=
# OIDC discovery document URL, on the same origin as CENTRAL_ORIGIN.
CENTRAL_OIDC_DISCOVERY_URL=
# Scheduled's OIDC application, created by the Central operator (confidential client).
CENTRAL_OIDC_CLIENT_ID=
CENTRAL_OIDC_CLIENT_SECRET=
# Audience Central set for Scheduled's sign-in. Set by the operator, never guessed.
CENTRAL_OIDC_AUDIENCE=
# Exact redirect URI registered with Central, for example https://scheduled.example/auth/titan/callback.
CENTRAL_OIDC_REDIRECT_URI=
# Service client (client credentials) for Scheduled's server-to-server calls.
# Central sign-in routes stay off unless CENTRAL_SIGNIN_ENABLED is 1 or true.
CENTRAL_SIGNIN_ENABLED=
CENTRAL_SERVICE_CLIENT_ID=
CENTRAL_SERVICE_CLIENT_SECRET=
# HMAC secret for Central's signed outbox events. At least 32 characters.
CENTRAL_EVENTS_HMAC_SECRET=
# Inbound signed Central events. The route stays unregistered unless CENTRAL_EVENTS_ENABLED is 1 or true.
CENTRAL_EVENTS_ENABLED=
# The one Central organisation (UUID) this installation accepts events for. Required when events are enabled.
CENTRAL_EVENTS_ORGANISATION_ID=
# Development only. Set to 1 to allow http://localhost origins. Never set in staging or production.
TITAN_ALLOW_INSECURE_LOCALHOST=
