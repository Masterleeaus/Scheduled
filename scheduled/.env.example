# Placeholder configuration for Scheduled. Copy to .env (git-ignored) and fill
# in real values from the operator. Never commit real values or key material.

# Central origin (HTTPS). Placeholder only; this package makes no network calls.
SCHEDULED_CENTRAL_ORIGIN=https://central.example.invalid

# aud claim in link assertions (contract value from Central docs/LINKING.md).
SCHEDULED_CENTRAL_AUDIENCE=titan-central

# Product id used as iss. PLACEHOLDER: the owner may change it (issue #1).
SCHEDULED_PRODUCT_ID=scheduled

# kid for the Ed25519 link-signing key. Placeholder.
SCHEDULED_LINK_KEY_ID=scheduled-link-placeholder-kid

# Ed25519 private key, PKCS#8 PEM. SECRET: load from the secret store, never commit.
# A literal \n sequence is accepted in place of newlines.
SCHEDULED_LINK_PRIVATE_KEY_PEM=
