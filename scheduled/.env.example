# Placeholder configuration for Scheduled. Copy to .env (git-ignored) and fill
# in real values from the operator. Never commit real values or key material.

# Name mapping. The Laravel core reads CENTRAL_* names (core/.env.example). This module reads SCHEDULED_* names.
#   SCHEDULED_CENTRAL_ORIGIN is the same value as CENTRAL_ORIGIN.
#   SCHEDULED_PRODUCT_ID is the product id that core fixes as 'scheduled' (CentralConfig::SCHEDULED_PRODUCT_ID).
# Different values, never copy between them:
#   SCHEDULED_CENTRAL_AUDIENCE is the link-assertion aud claim; CENTRAL_OIDC_AUDIENCE is the operator-set sign-in audience.
# SCHEDULED_LINK_* (Ed25519 link signing) has no core counterpart.

# Central origin (HTTPS). Placeholder only; this package makes no network calls.
SCHEDULED_CENTRAL_ORIGIN=https://central.example.invalid

# aud claim in link assertions (contract value from Central docs/LINKING.md).
SCHEDULED_CENTRAL_AUDIENCE=titan-central

# Product id used as iss. PLACEHOLDER: the owner may change it (issue #1).
SCHEDULED_PRODUCT_ID=scheduled

# kid for the Ed25519 link-signing key. Placeholder. Letters, digits, dots, underscores, hyphens; 64 max.
SCHEDULED_LINK_KEY_ID=scheduled-link-placeholder-kid

# Ed25519 private key, PKCS#8 PEM. SECRET: load from the secret store, never commit.
# A literal \n sequence is accepted in place of newlines.
SCHEDULED_LINK_PRIVATE_KEY_PEM=

# Used only by scripts/export-public-jwk.js to print the Central key entry.
# notBefore is required by Central (RFC 3339 with offset). notAfter is optional.
SCHEDULED_LINK_NOT_BEFORE=
SCHEDULED_LINK_NOT_AFTER=
